PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
CORS_ORIGINS=*
TIMEZONE=America/Bogota

# Autenticación (JWT + bcrypt)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Secreto de un solo uso para crear el primer super_admin
# POST /api/auth/bootstrap-superadmin  con header: x-setup-secret: <este valor>
SETUP_SECRET=cambia-esto-tambien

# SSL de Postgres (pon "false" si tu DB local no usa TLS)
PGSSL=true
